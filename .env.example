# LCFMS Environment Variables
# Split deployment: Frontend on Vercel + Backend on Render

# ========================================
# BACKEND (Render) - Set these in Render Dashboard
# ========================================

# Database (Render PostgreSQL - auto-populated by Render)
DATABASE_URL=postgresql://lcfms:changeme@localhost:5432/lcfms

# Redis (Render Redis - auto-populated by Render)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT (Generate a strong secret: openssl rand -base64 64)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Backend App Config
NODE_ENV=production
PORT=10000
# Comma-separated for multiple origins (Vercel preview + production)
FRONTEND_URL=https://your-app.vercel.app,https://your-app-git-main-yourname.vercel.app

# AWS (for S3 file uploads)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=

# Email (for notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@lcfms.io

# SMS (for Twilio)
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_PHONE=

# ========================================
# FRONTEND (Vercel) - Set these in Vercel Dashboard
# ========================================

# Public env vars (available in browser + build time)
NEXT_PUBLIC_API_URL=https://your-render-api-url.onrender.com
NEXT_PUBLIC_MAPBOX_TOKEN=your-mapbox-token
